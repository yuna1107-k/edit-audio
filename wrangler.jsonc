{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edit-audio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
